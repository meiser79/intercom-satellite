<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Widgets cannot use theme attributes, so they map to the dynamic system palette. -->
    <color name="widget_surface">@android:color/system_neutral1_50</color>
    <color name="widget_primary">@android:color/system_accent1_600</color>
    <color name="widget_on_surface">@android:color/system_neutral1_900</color>
    <color name="widget_on_primary">@android:color/system_accent1_0</color>
    <color name="widget_container">@android:color/system_accent2_100</color>
    <color name="widget_on_container">@android:color/system_accent2_900</color>
    <color name="widget_on_surface_variant">@android:color/system_neutral2_700</color>
    <!-- Kiosk status on the widget: fixed, so it means the same on every wallpaper. -->
    <color name="widget_status_online">#2E7D32</color>
    <color name="widget_status_dnd">#BA1A1A</color>
    <color name="widget_status_offline">#75777F</color>
    <color name="launcher_background">@android:color/system_accent1_600</color>
    <color name="launcher_foreground">@android:color/system_accent1_0</color>
</resources>
