<?xml version="1.0" encoding="utf-8"?>
<!-- Kiosk on Do not disturb, drawn like Android's own symbol. The ring in the kiosk tile's color sets the badge off the room icon. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval"><solid android:color="?attr/colorSurfaceContainerHighest" /><size android:width="16dp" android:height="16dp" /></shape>
    </item>
    <item android:bottom="2dp" android:left="2dp" android:right="2dp" android:top="2dp">
        <shape android:shape="oval"><solid android:color="@color/widget_status_dnd" /></shape>
    </item>
    <item android:gravity="center" android:width="6.5dp" android:height="1.6dp">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorSurfaceContainerHighest" />
            <corners android:radius="0.8dp" />
        </shape>
    </item>
</layer-list>
