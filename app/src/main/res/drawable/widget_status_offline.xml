<?xml version="1.0" encoding="utf-8"?>
<!-- Kiosk offline or not usable. The ring in the widget's own color sets the badge off the room icon. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval"><solid android:color="@color/widget_surface" /><size android:width="10dp" android:height="10dp" /></shape>
    </item>
    <item android:bottom="2.2dp" android:left="2.2dp" android:right="2.2dp" android:top="2.2dp">
        <shape android:shape="oval">
            <stroke android:width="1.4dp" android:color="@color/widget_status_offline" />
        </shape>
    </item>
</layer-list>
