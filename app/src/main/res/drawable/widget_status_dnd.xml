<?xml version="1.0" encoding="utf-8"?>
<!-- Kiosk on Do not disturb, drawn like Android's own symbol. The ring in the widget's own color sets the badge off the room icon. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval"><solid android:color="@color/widget_surface" /><size android:width="10dp" android:height="10dp" /></shape>
    </item>
    <item android:bottom="1.5dp" android:left="1.5dp" android:right="1.5dp" android:top="1.5dp">
        <shape android:shape="oval"><solid android:color="@color/widget_status_dnd" /></shape>
    </item>
    <item android:gravity="center" android:width="5dp" android:height="1.2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_surface" />
            <corners android:radius="0.6dp" />
        </shape>
    </item>
</layer-list>
