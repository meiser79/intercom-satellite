<?xml version="1.0" encoding="utf-8"?>
<!-- Kiosk online. The ring in the widget's own color sets the badge off the room icon. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval"><solid android:color="@color/widget_surface" /><size android:width="10dp" android:height="10dp" /></shape>
    </item>
    <item android:bottom="1.5dp" android:left="1.5dp" android:right="1.5dp" android:top="1.5dp">
        <shape android:shape="oval"><solid android:color="@color/widget_status_online" /></shape>
    </item>
</layer-list>
