<?xml version="1.0" encoding="utf-8"?>
<!-- Only the settings file goes into backups; what in it belongs to this phone alone is dropped
     after a restore, see Config. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="intercom.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="intercom.xml" />
    </device-transfer>
</data-extraction-rules>
